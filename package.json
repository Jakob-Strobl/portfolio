{
  "name": "portfolio",
  "type": "module",
  "version": "0.11.0",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jakob-Strobl/portfolio"
  },
  "scripts": {
    "dev": "vite dev",
    "prebuild": "bun scripts/clear-nitro-deploy-config.ts",
    "build": "vite build",
    "cloudflare-step-deploy": "vitest run && bun run build",
    "cloudflare-deploy-local": "bun run build && bunx wrangler pages deploy dist --project-name=portfolio",
    "start": "vite preview",
    "test": "vitest run",
    "test-watch": "vitest",
    "pretty-check": "bunx prettier . --check",
    "prettify": "bunx prettier . --write"
  },
  "dependencies": {
    "@solid-primitives/intersection-observer": "^2.2.5",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.0-rc.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-solid": "^1.28.0",
    "nitro": "^3.0.260610-beta",
    "posthog-js": "^1.409.5",
    "posthog-node": "^5.47.3",
    "solid-js": "^1.9.14"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/user-event": "^14.6.1",
    "autoprefixer": "^10.5.4",
    "baseline-browser-mapping": "^2.11.9",
    "git-format-staged": "^4.0.1",
    "happy-dom": "^20.11.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-glsl": "^1.6.1",
    "vite-plugin-solid": "2.11.14",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
