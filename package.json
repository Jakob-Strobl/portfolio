{
  "name": "portfolio",
  "type": "module",
  "version": "0.12.6",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jakob-Strobl/portfolio"
  },
  "scripts": {
    "dev": "vite dev",
    "prebuild": "bun scripts/clear-nitro-deploy-config.ts",
    "build": "vite build",
    "cloudflare-step-deploy": "bun install --frozen-lockfile && bun run test && bun run build",
    "cloudflare-deploy-local": "bun run build && bunx wrangler pages deploy dist --project-name=portfolio",
    "start": "vite preview",
    "test": "vitest run",
    "test-watch": "vitest",
    "pretty-check": "bunx prettier . --check",
    "prettify": "bunx prettier . --write"
  },
  "dependencies": {
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "2.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-solid": "^1.61.0",
    "nitro": "^3.0.260610-beta",
    "posthog-js": "^1.438.14",
    "solid-js": "1.9.17"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "happy-dom": "^20.14.6",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-glsl": "^1.6.2",
    "vite-plugin-solid": "2.11.14",
    "vitest": "^4.1.12",
    "wrangler": "4.151.3"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "defu": "6.1.7",
    "dompurify": "3.4.17",
    "mdast-util-to-hast": "13.2.1",
    "rollup": "4.61.1",
    "undici": "8.12.2",
    "seroval": "1.6.12",
    "seroval-plugins": "1.6.12",
    "source-map-js": "1.2.2",
    "fflate": "0.4.9",
    "nanoid": "3.3.18",
    "sharp": "0.35.5"
  }
}
